{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "defaultProject": "pit-common-core-lib",
    "projects": {
        "pit-common-core-lib": {
            "root": "projects/pit-common-core-lib",
            "sourceRoot": "projects/pit-common-core-lib/src",
            "projectType": "library",
            "prefix": "pit",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "projects/pit-common-core-lib/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/pit-common-core-lib/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/pit-common-core-lib/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                }
            }
        }
    },
    "cli": {
      "analytics": false
    }
}